{
  "name": "rtd-system-map",
  "private": true,
  "type": "module",
  "description": "A clean, mobile-friendly map of the RTD transit system, built from RTD's public data.",
  "license": "Apache-2.0",
  "scripts": {
    "postinstall": "node scripts/vendor.mjs && node scripts/tiles.mjs",
    "build": "node scripts/vendor.mjs && node scripts/tiles.mjs && node scripts/publish-check.mjs",
    "build:data": "node scripts/vendor.mjs && node scripts/build-data.mjs && node scripts/tiles.mjs && node scripts/poster-build.mjs",
    "build:sheets": "node scripts/vendor.mjs && node scripts/sheets.mjs && node scripts/tiles.mjs && node scripts/poster-build.mjs",
    "build:basemap": "node scripts/basemap.mjs && node scripts/tiles.mjs",
    "sheets": "node scripts/sheets.mjs",
    "dev": "NODE_OPTIONS=--max-old-space-size=4096 wrangler pages dev public --port 8788",
    "dev:live": "wrangler dev --config live/wrangler.toml --port 8789",
    "start": "npm run build && npm run dev",
    "deploy": "node scripts/deploy.mjs",
    "test": "node --test",
    "check": "playwright test -c qa/playwright.config.mjs --grep-invert @deep",
    "check:sheets": "node qa/sheets.mjs",
    "check:wide-zoom": "node scripts/wide-zoom.mjs",
    "check:health": "playwright test -c qa/playwright.config.mjs health",
    "check:a11y": "node qa/a11y.mjs",
    "check:classic": "playwright test -c qa/classic/playwright.config.mjs --grep-invert @deep",
    "check:classic:deep": "playwright test -c qa/classic/playwright.config.mjs --grep @deep",
    "check:classic:baselines": "playwright test -c qa/classic/playwright.config.mjs visual --update-snapshots=all",
    "check:report": "playwright show-report qa/report",
    "check:classic:map": "node qa/checks/report.mjs",
    "check:recall": "node qa/recall/recall.mjs",
    "check:accuracy": "node qa/accuracy.mjs",
    "check:evidence": "node qa/evaluation/run.mjs",
    "sweep:classic": "node qa/sweep/sweep.mjs",
    "watch:rtd": "node refresh/watch.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.0",
    "@mapbox/tiny-sdf": "2.3.0",
    "@maplibre/maplibre-gl-style-spec": "26.5.1",
    "@napi-rs/canvas": "1.1.0",
    "@playwright/test": "1.55.1",
    "fflate": "0.8.3",
    "pbf": "5.1.2",
    "pmtiles": "4.5.0",
    "wrangler": "4.80.0"
  },
  "dependencies": {
    "@fontsource-variable/overpass": "5.3.0",
    "maplibre-gl": "6.19.0"
  }
}
